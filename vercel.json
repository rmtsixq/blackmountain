{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build && node -e \"const fs=require('fs');fs.rmSync('.vercel/output',{recursive:true,force:true});fs.mkdirSync('.vercel/output',{recursive:true});fs.cpSync('dist','.vercel/output/static',{recursive:true});fs.writeFileSync('.vercel/output/config.json',JSON.stringify({version:3}))\"",
  "outputDirectory": "dist"
}
